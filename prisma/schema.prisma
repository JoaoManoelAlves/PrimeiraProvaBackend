generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id      String    @id @default(uuid())
  name    String
  email   String    @unique
  pedidos Pedidos[]
}

model Product {
  id      String    @id @default(uuid())
  name    String
  price   Float
  pedidos Pedidos[]
}

model Pedidos {
  id         String  @id @default(uuid())
  clientId   String
  totalValue Float
  client     Client  @relation(fields: [clientId], references: [id])
  product Product[]
}
